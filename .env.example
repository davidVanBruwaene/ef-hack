# cp .env.example .env, then fill in real values in .env.
# This file is committed: variable names only, never values.

# OpenRouter key for the supervisor's Jev calls (supervisor/). Leave unset to read OPENROUTER_KEY_FILE instead.
OPENROUTER_API_KEY=
# File holding the OpenRouter key, read on every call. Defaults to ~/keys/openrouter/key.
OPENROUTER_KEY_FILE=
# Set to 1 to run the supervisor's live Jev smoke test.
JEV_LIVE=

EXAMPLE_API_KEY=
# Passkey store (store/): all optional, defaults suit local dev.
STORE_PORT=
STORE_DB=
RP_ID=
RP_NAME=
RP_ORIGINS=
STORE_DEV_PAGE=
PUBLIC_URL=
STORE_INTERNAL_TOKEN=

# AAuth server identifiers (https, no port). Leave unset to run on loopback as *.aauth.test.
AAUTH_PS=
AAUTH_AGENT=
AAUTH_RESOURCE=
# Local ports, to run a second world beside the first. Default 4401, 4402, 4403 and 4411.
AAUTH_PS_PORT=
AAUTH_RESOURCE_PORT=
AAUTH_AGENT_PORT=
AAUTH_MOCKIN_PORT=
# Directory for the spike's state files, to run a second world. Defaults to spike/aauth-mcp/.data.
AAUTH_DATA_DIR=
# Name Bob's person server puts in auth tokens. Defaults to Bob.
BOB_NAME=
# Bearer token for Alice's /api. Leave unset to generate one into spike/aauth-mcp/.keys/alice-console-token.
ALICE_CONSOLE_TOKEN=
# Seconds a call waits on an Ask-me answer before returning it as pending. Defaults to 55.
ALICE_ASK_WAIT_S=
# The people network: the store's URL, read with STORE_INTERNAL_TOKEN. Leave unset to serve alice.json.
STORE_URL=
# The member each person server speaks for, as inline JSON or a file path: {"<person server>": "<member id>"}.
MEMBER_MAP=
# Bearer token for Bob's /api. Leave unset to generate one into spike/aauth-mcp/.keys/bob-console-token.
BOB_CONSOLE_TOKEN=
